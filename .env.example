# Copy to .env.local for local development. Never commit real values.
MONGODB_URI=
MONGODB_DB=
# Random string, at least 32 characters (e.g. openssl rand -base64 48)
SESSION_SECRET=

# GitHub OAuth App credentials. See doc/github-oauth.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Public origin of the app (e.g. https://your-app.vercel.app).
# When empty, the origin of the incoming request is used.
APP_URL=
